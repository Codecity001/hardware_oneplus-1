typeattribute hal_camera_default vendor_hal_qspmhal_client;

hal_attribute_hwservice(hal_camera, vendor_hal_camera_extension_hwservice)

hal_client_domain(hal_camera_default, vendor_hal_cameraMDM)
hal_client_domain(hal_camera_default, vendor_hal_oplus_cammidasservice)
hal_client_domain(hal_camera_default, vendor_hal_oplus_charger)
hal_client_domain(hal_camera_default, vendor_hal_oplus_commondcs)
hal_client_domain(hal_camera_default, vendor_hal_oplus_osense)
hal_client_domain(hal_camera_default, vendor_hal_oplus_performance)
hal_client_domain(hal_camera_default, vendor_hal_oplus_urcc)
hal_client_domain(hal_camera_default, vendor_hal_qspmhal)
hal_client_domain(hal_camera_default, vendor_hal_vpp)

add_service(hal_camera_default, hal_oplus_aon_aidl_service)

allow hal_camera_default self:capability ipc_lock;

allow hal_camera_default system_server:binder call;

allow hal_camera_default hal_oplus_olc_aidl_service:service_manager find;
allow hal_camera_default osense_service:service_manager find;

allow hal_camera_default vendor_hal_camera_postproc_hwservice:hwservice_manager find;
allow hal_camera_default vendor_hal_orms_hwservice:hwservice_manager find;
allow hal_camera_default vendor_hal_osense_hwservice:hwservice_manager find;

allow hal_camera_default public_adsprpcd_file:file r_file_perms;

# FastRPC DSP access for arcsoft bokeh depth processing (CDSP offloading)
# QCOM base policy only grants read; OOS grants read+write for both devices.
# vendor_qdsp_device = /dev/adsprpc-smd (non-secure FastRPC)
# vendor_xdsp_device = /dev/adsprpc-smd-secure (secure FastRPC, used by CDSP)
allow hal_camera_default vendor_qdsp_device:chr_file rw_file_perms;
allow hal_camera_default vendor_xdsp_device:chr_file rw_file_perms;

allow hal_camera_default input_device:chr_file rw_file_perms;
allow hal_camera_default vendor_camera_turbo_device:chr_file rw_file_perms;
allow hal_camera_default vendor_tof_device:chr_file rw_file_perms;
allow hal_camera_default cgroup:file rw_file_perms;
allow hal_camera_default proc:file rw_file_perms;
allow hal_camera_default vendor_data_file:file rw_file_perms;
allow hal_camera_default vendor_data_file:dir { search add_name };

allow hal_camera_default mnt_vendor_file:dir search;

allow hal_camera_default proc_meminfo:file r_file_perms;

allow hal_camera_default vendor_camera_update_data_file:dir rw_dir_perms;
allow hal_camera_default vendor_camera_update_data_file:file create_file_perms;

allow hal_camera_default vendor_persist_camera_file:dir w_dir_perms;
allow hal_camera_default vendor_persist_camera_file:file create_file_perms;

r_dir_file(hal_camera_default, input_device)
r_dir_file(hal_camera_default, proc_version)
r_dir_file(hal_camera_default, vendor_proc_oplus_version)
r_dir_file(hal_camera_default, vendor_sysfs_usb_supply)
rw_dir_file(hal_camera_default, vendor_proc_camera)
rw_dir_file(hal_camera_default, vendor_sysfs_tof)

set_prop(hal_camera_default, vendor_camera_prop)

# VPP data access (types defined in Qualcomm sepolicy_vndr)
allow hal_camera_default vendor_vpp_data_file:dir create_dir_perms;
allow hal_camera_default vendor_vpp_data_file:file create_file_perms;
allow hal_camera_default vendor_camera_data_file:dir create_dir_perms;
allow hal_camera_default vendor_camera_data_file:file create_file_perms;
allow hal_camera_default vendor_persist_vpp_file:dir r_dir_perms;
allow hal_camera_default vendor_persist_vpp_file:file r_file_perms;
